# --- Backend Django (backend/) ---
DJANGO_SECRET_KEY=remplacez-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Clôture des inscriptions (lundi 9 novembre 2026, 23 h 59, heure de Dakar = UTC)
