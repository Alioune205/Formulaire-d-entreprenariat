# --- Frontend React (frontend/) ---
# Vide en local (le proxy Vite redirige /api vers Django).
# En production, l'URL publique du backend, ex. https://api.mon-club.sn
VITE_API_URL=

# --- E-mails (à mettre dans backend/.env) ---
