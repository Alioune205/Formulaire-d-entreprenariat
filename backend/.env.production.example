# ============================================================
#  Configuration de PRODUCTION (PythonAnywhere)
#  À copier en backend/.env SUR LE SERVEUR, puis remplacer :
#    VOTRE-IDENTIFIANT  -> votre identifiant PythonAnywhere
#    VOTRE-SITE         -> l'adresse donnée par Vercel
# ============================================================

DJANGO_DEBUG=0
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=VOTRE-IDENTIFIANT.pythonanywhere.com
# PythonAnywhere place un proxy devant Django : nécessaire pour lire la vraie IP des visiteurs.
DJANGO_NUM_PROXIES=1

# Frontend React hébergé sur Vercel
CORS_ALLOWED_ORIGINS=https://VOTRE-SITE.vercel.app
FRONTEND_URL=https://VOTRE-SITE.vercel.app
CSRF_TRUSTED_ORIGINS=https://VOTRE-IDENTIFIANT.pythonanywhere.com

# Clôture des inscriptions (heure de Dakar = UTC)
DATE_LIMITE_INSCRIPTION=2026-11-11T23:59:59+00:00

# E-mails (Gmail) — utiliser un NOUVEAU mot de passe d'application
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=senepapealioune0@gmail.com
DEFAULT_FROM_EMAIL=Club d'Entrepreneuriat CIAT <senepapealioune0@gmail.com>
EMAIL_HOST_PASSWORD=
